SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b-conversations
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_VOICE=shubh_enhi_ads

# Local npm run dev/start launches both services with an ephemeral shared secret.
# Vercel: set ENABLED=true and a persistent SECRET (32+ random characters).
# Leave PUBLIC_URL and ALLOWED_ORIGINS unset on Vercel for same-origin WebSockets.
VOICE_STREAMING_ENABLED=true
VOICE_PUBLIC_URL=ws://127.0.0.1:3001/voice
VOICE_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
VOICE_PORT=3001
VOICE_HOST=127.0.0.1
VOICE_MAX_SESSIONS=10
VOICE_SILENCE_MS=600
VOICE_VALIDATION_MODE=segments
# Use the same secret on web and voice servers if deploying them separately.
VOICE_SESSION_SECRET=
